// Sistema de Transformación y Propósito — Iglesia Vive
// Modelo de datos base (ver design/ESPECIFICACION_PRODUCTO.md §17).
//
// Regla arquitectónica crítica (ARQUITECTURA_VISUAL.md §11): la relación de
// discipulado NO es un campo `mentorId` en Person. Es la entidad
// MentorRelationship con historial (desde, hasta, motivo, quién autorizó).

// El cliente se genera dentro de node_modules, como paquete: así el bundler de
// Next lo trata como dependencia externa y la resolución por condiciones elige
// la variante correcta —`workerd` en Cloudflare, Node en el seed y los
// scripts—. Generado en `postinstall`.
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@iglesia/prisma-client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- Identidad

enum Role {
  APRENDIZ
  CONSOLIDADOR
  LIDER_ALPHA
  MENTOR
  PASTOR
  ADMIN
}

enum Gender {
  MUJER
  HOMBRE
}

/// Usuario de la plataforma. La autenticación vive en Supabase Auth; aquí
/// guardamos el rol y el vínculo con la persona. `authUserId` se enlaza en el
/// primer inicio de sesión a partir del correo pre-aprovisionado.
model AppUser {
  id         String   @id @default(uuid())
  authUserId String?  @unique @map("auth_user_id") @db.Uuid
  email      String   @unique
  fullName   String   @map("full_name")
  role       Role
  active     Boolean  @default(true)
  /// Capacidad máxima de acompañamiento simultáneo (consolidador / mentor).
  capacity   Int      @default(12)
  personId   String?  @unique @map("person_id")
  teamId     String?  @map("team_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  person Person? @relation(fields: [personId], references: [id])
  team   Team?   @relation(fields: [teamId], references: [id])

  consolidadorDe        LearnerProfile[]     @relation("ConsolidadorAsignado")
  relacionesComoMentor  MentorRelationship[] @relation("MentorDeRelacion")
  relacionesAutorizadas MentorRelationship[] @relation("AutorizadaPor")
  op72Propuestas        Operation72[]        @relation("MentorPropuesto")
  contactosRegistrados  ContactAttempt[]
  notasEscritas         PrivateNote[]
  hitosRegistrados      Milestone[]
  temasRegistrados      FaithHouseProgress[]
  gruposAlphaLiderados  AlphaProgram[]       @relation("LiderDeAlpha")
  validacionesAlpha     AlphaEnrollment[]    @relation("ValidacionAlpha")
  asistenciasAlpha      AlphaAttendance[]
  registrosCreados      LearnerProfile[]     @relation("RegistradaPor")
  eventosCreados        Event[]              @relation("EventoCreadoPor")
  inscripcionesEvento   EventRegistration[]  @relation("InscribioAEvento")
  asistenciasEvento     EventRegistration[]  @relation("MarcoAsistenciaEvento")
  auditoria             AuditLog[]

  @@index([role, active])
  @@map("app_user")
}

model Team {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  members     AppUser[]
  learners    LearnerProfile[]
  gruposAlpha AlphaProgram[]
  eventos     Event[]

  @@map("team")
}

// ----------------------------------------------------------------- Personas

enum EntryPoint {
  SERVICIO_DOMINICAL
  SERVICIO_MIERCOLES
  REDES_SOCIALES
  ALPHA_CASA_DE_FE
  EVENTO_O_BRIGADA
  UNO_A_UNO
}

enum InvitationKind {
  PERSONA
  REDES
  DESCONOCIDO
}

enum CallSchedule {
  MANANA
  TARDE
  NOCHE
}

/// Identidad de una persona. Los teléfonos se conservan por tipo
/// (ESPECIFICACION_PRODUCTO.md §20).
model Person {
  id            String        @id @default(uuid())
  firstName     String        @map("first_name")
  lastName      String        @map("last_name")
  gender        Gender
  birthDate     DateTime?     @map("birth_date") @db.Date
  callPhone     String?       @map("call_phone")
  whatsappPhone String?       @map("whatsapp_phone")
  email         String?
  address       String?
  prayerRequest String?       @map("prayer_request")
  photoUrl      String?       @map("photo_url")
  callSchedule  CallSchedule? @map("call_schedule")
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user           AppUser?
  learnerProfile LearnerProfile?
  invitados      LearnerProfile[] @relation("InvitadaPor")

  @@index([callPhone])
  @@index([whatsappPhone])
  @@index([email])
  @@map("person")
}

enum Phase {
  GANAR
  FORTALECER
  ENTRENAR
  MULTIPLICAR
}

enum LearnerStatus {
  ACTIVO
  PAUSADO
  RETIRADO
  GRADUADO
}

/// Expediente vivo del aprendiz.
model LearnerProfile {
  id             String        @id @default(uuid())
  personId       String        @unique @map("person_id")
  phase          Phase         @default(GANAR)
  status         LearnerStatus @default(ACTIVO)
  phaseStartedAt DateTime      @default(now()) @map("phase_started_at")

  // Origen
  entryPoint        EntryPoint     @map("entry_point")
  invitationKind    InvitationKind @map("invitation_kind")
  invitedByPersonId String?        @map("invited_by_person_id")
  /// Línea de origen conservada cuando hay invitador conocido.
  lineOfOrigin      String?        @map("line_of_origin")
  originNotes       String?        @map("origin_notes")

  consolidatorId String?  @map("consolidator_id")
  teamId         String?  @map("team_id")
  registeredById String?  @map("registered_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  person       Person   @relation(fields: [personId], references: [id])
  invitedBy    Person?  @relation("InvitadaPor", fields: [invitedByPersonId], references: [id])
  consolidator AppUser? @relation("ConsolidadorAsignado", fields: [consolidatorId], references: [id])
  team         Team?    @relation(fields: [teamId], references: [id])
  registeredBy AppUser? @relation("RegistradaPor", fields: [registeredById], references: [id])

  operation72         Operation72?
  mentorRelationships MentorRelationship[]
  milestones          Milestone[]
  privateNotes        PrivateNote[]
  faithHouseProgress  FaithHouseProgress[]
  alphaEnrollments    AlphaEnrollment[]
  eventRegistrations  EventRegistration[]

  @@index([phase, status])
  @@map("learner_profile")
}

/// Historial de discipulado: quién fue mentor, desde cuándo, hasta cuándo,
/// por qué cambió y quién autorizó el cambio.
model MentorRelationship {
  id             String    @id @default(uuid())
  learnerId      String    @map("learner_id")
  mentorId       String    @map("mentor_id")
  startedAt      DateTime  @default(now()) @map("started_at")
  endedAt        DateTime? @map("ended_at")
  reason         String?
  authorizedById String?   @map("authorized_by_id")
  /// true cuando se conservó la línea del invitador.
  keepsLine      Boolean   @default(false) @map("keeps_line")
  createdAt      DateTime  @default(now()) @map("created_at")

  learner      LearnerProfile @relation(fields: [learnerId], references: [id])
  mentor       AppUser        @relation("MentorDeRelacion", fields: [mentorId], references: [id])
  authorizedBy AppUser?       @relation("AutorizadaPor", fields: [authorizedById], references: [id])

  @@index([learnerId, endedAt])
  @@index([mentorId, endedAt])
  @@map("mentor_relationship")
}

// ------------------------------------------------------------ Operación 72

enum Operation72Status {
  INICIADA
  CONTACTADA
  VISITA_PENDIENTE
  LISTA_PARA_ENTREGA
  ENTREGADA
  CERRADA
}

model Operation72 {
  id                 String            @id @default(uuid())
  learnerId          String            @unique @map("learner_id")
  status             Operation72Status @default(INICIADA)
  startedAt          DateTime          @default(now()) @map("started_at")
  /// startedAt + 72 h. Las horas restantes se calculan siempre en servidor.
  deadlineAt         DateTime          @map("deadline_at")
  deliveredAt        DateTime?         @map("delivered_at")
  /// Resumen corto que se muestra en la tarjeta del tablero.
  detail             String
  /// true = llegó con invitador conocido y se conserva la línea.
  lineKnown          Boolean           @default(false) @map("line_known")
  proposedMentorId   String?           @map("proposed_mentor_id")
  proposedMentorNote String?           @map("proposed_mentor_note")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  learner        LearnerProfile   @relation(fields: [learnerId], references: [id])
  proposedMentor AppUser?         @relation("MentorPropuesto", fields: [proposedMentorId], references: [id])
  attempts       ContactAttempt[]

  @@index([status, deadlineAt])
  @@map("operation72")
}

enum ContactType {
  LLAMADA
  INTENTO_LLAMADA
  MENSAJE
  CONVERSACION
  VISITA
  INTENTO_VISITA
}

model ContactAttempt {
  id            String      @id @default(uuid())
  operation72Id String      @map("operation72_id")
  type          ContactType
  result        String?
  note          String?
  nextAction    String?     @map("next_action")
  occurredAt    DateTime    @default(now()) @map("occurred_at")
  byUserId      String?     @map("by_user_id")
  createdAt     DateTime    @default(now()) @map("created_at")

  operation72 Operation72 @relation(fields: [operation72Id], references: [id], onDelete: Cascade)
  byUser      AppUser?    @relation(fields: [byUserId], references: [id])

  @@index([operation72Id, occurredAt])
  @@map("contact_attempt")
}

// ------------------------------------------------------------------- Alpha

/// Grupo de Alpha. Referencia: 3 meses, 12 sesiones
/// (ESPECIFICACION_PRODUCTO.md §5.7).
model AlphaProgram {
  id        String    @id @default(uuid())
  name      String
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  leaderId  String    @map("leader_id")
  teamId    String?   @map("team_id")
  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  leader      AppUser           @relation("LiderDeAlpha", fields: [leaderId], references: [id])
  team        Team?             @relation(fields: [teamId], references: [id])
  sessions    AlphaSession[]
  enrollments AlphaEnrollment[]

  @@index([leaderId, closedAt])
  @@map("alpha_program")
}

model AlphaSession {
  id        String   @id @default(uuid())
  programId String   @map("program_id")
  number    Int
  date      DateTime @db.Date
  topic     String
  createdAt DateTime @default(now()) @map("created_at")

  program    AlphaProgram      @relation(fields: [programId], references: [id], onDelete: Cascade)
  attendance AlphaAttendance[]

  @@unique([programId, number])
  @@map("alpha_session")
}

/// Participación de una persona en el grupo. Aquí viven el Focus Day y la
/// validación final del líder, que son las dos condiciones que el sistema no
/// puede dar por cumplidas solo.
model AlphaEnrollment {
  id             String    @id @default(uuid())
  programId      String    @map("program_id")
  learnerId      String    @map("learner_id")
  joinedAt       DateTime  @default(now()) @map("joined_at")
  focusDayAt     DateTime? @map("focus_day_at")
  validatedAt    DateTime? @map("validated_at")
  validatedById  String?   @map("validated_by_id")
  validationNote String?   @map("validation_note")

  program     AlphaProgram      @relation(fields: [programId], references: [id], onDelete: Cascade)
  learner     LearnerProfile    @relation(fields: [learnerId], references: [id])
  validatedBy AppUser?          @relation("ValidacionAlpha", fields: [validatedById], references: [id])
  attendance  AlphaAttendance[]

  @@unique([programId, learnerId])
  @@map("alpha_enrollment")
}

model AlphaAttendance {
  id           String   @id @default(uuid())
  sessionId    String   @map("session_id")
  enrollmentId String   @map("enrollment_id")
  present      Boolean  @default(false)
  /// Observación privada de la sesión: no se muestra al aprendiz.
  note         String?
  recordedById String?  @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  session    AlphaSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment AlphaEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recordedBy AppUser?        @relation(fields: [recordedById], references: [id])

  @@unique([sessionId, enrollmentId])
  @@map("alpha_attendance")
}

// ----------------------------------------------------- Hitos, notas, Casa de Fe

enum MilestoneKind {
  REGISTRO
  OPERACION_72
  ALPHA
  FOCUS_DAY
  CASA_DE_FE
  BAUTISMO
  ENCUENTRO
  EVALUACION_CIERRE
  GRADUACION
  VALIDACION_PASTORAL
  ENTRADA_ESCUELA
  SERVICIO
  MULTIPLICACION
}

enum MilestoneStatus {
  PENDIENTE
  EN_CURSO
  COMPLETADO
}

model Milestone {
  id           String          @id @default(uuid())
  learnerId    String          @map("learner_id")
  kind         MilestoneKind
  status       MilestoneStatus @default(PENDIENTE)
  achievedAt   DateTime?       @map("achieved_at")
  detail       String?
  /// Ninguna transición es automática: siempre queda el responsable humano.
  recordedById String?         @map("recorded_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")

  learner    LearnerProfile @relation(fields: [learnerId], references: [id])
  recordedBy AppUser?       @relation(fields: [recordedById], references: [id])

  @@unique([learnerId, kind])
  @@map("milestone")
}

/// Privadas frente al aprendiz. Visibles para su mentor, su consolidador y el
/// líder responsable de la línea. Cada apertura se audita.
model PrivateNote {
  id        String   @id @default(uuid())
  learnerId String   @map("learner_id")
  authorId  String   @map("author_id")
  kind      String
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  learner LearnerProfile @relation(fields: [learnerId], references: [id])
  author  AppUser        @relation(fields: [authorId], references: [id])

  @@index([learnerId, createdAt])
  @@map("private_note")
}

enum FaithHouseStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
  REQUIERE_SEGUIMIENTO
}

/// 12 temas obligatorios, orden flexible decidido por el mentor.
model FaithHouseTopic {
  id     String @id @default(uuid())
  number Int    @unique
  name   String

  progress FaithHouseProgress[]

  @@map("faith_house_topic")
}

/// Avance de un tema. Guarda lo que pide el §6.2: fecha, mentor, estado,
/// evaluación breve, nota privada, tarea o práctica y evidencia.
model FaithHouseProgress {
  id           String           @id @default(uuid())
  learnerId    String           @map("learner_id")
  topicId      String           @map("topic_id")
  status       FaithHouseStatus @default(PENDIENTE)
  completedAt  DateTime?        @map("completed_at")
  /// Nota privada del tema: no se muestra al aprendiz.
  notes        String?
  /// Evaluación breve del mentor, también privada.
  assessment   String?
  /// Tarea o práctica acordada.
  task         String?
  /// Evidencia documentada cuando corresponda.
  evidence     String?
  recordedById String?          @map("recorded_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  learner    LearnerProfile  @relation(fields: [learnerId], references: [id])
  topic      FaithHouseTopic @relation(fields: [topicId], references: [id])
  recordedBy AppUser?        @relation(fields: [recordedById], references: [id])

  @@unique([learnerId, topicId])
  @@map("faith_house_progress")
}

// ---------------------------------------------- Auditoría e integraciones

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor AppUser? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// ------------------------------------------------------------------ Eventos

/// Tipos de evento del §14. Encuentro y Bautismo están aquí y no en tablas
/// aparte porque son eventos con fecha, cupo e inscripción como los demás; lo
/// que los distingue es que su asistencia cierra un hito obligatorio (§6.4).
enum EventKind {
  SERVICIO
  ALPHA
  FOCUS_DAY
  ENCUENTRO
  BAUTISMO
  CUMBRE
  ESCUELA
  TALLER
  REUNION
  ACTIVIDAD
}

enum EventRegistrationStatus {
  INSCRITO
  CONFIRMADO
  ASISTIO
  NO_ASISTIO
  CANCELADO
}

model Event {
  id          String    @id @default(uuid())
  kind        EventKind
  title       String
  description String?
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  location    String?
  /// Cupo máximo. Nulo = sin límite.
  capacity    Int?
  /// Segmentación (§14): a qué fases se dirige. Vacío = a toda la iglesia.
  phases      Phase[]
  teamId      String?   @map("team_id")
  /// Mientras no esté publicado solo lo ven los líderes.
  publishedAt DateTime? @map("published_at")
  cancelledAt DateTime? @map("cancelled_at")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  team          Team?               @relation(fields: [teamId], references: [id])
  createdBy     AppUser             @relation("EventoCreadoPor", fields: [createdById], references: [id])
  registrations EventRegistration[]

  @@index([startsAt])
  @@index([kind, startsAt])
  @@map("event")
}

model EventRegistration {
  id             String                  @id @default(uuid())
  eventId        String                  @map("event_id")
  learnerId      String                  @map("learner_id")
  status         EventRegistrationStatus @default(INSCRITO)
  note           String?
  registeredById String?                 @map("registered_by_id")
  /// Quién marcó la asistencia: nunca es automática.
  attendedById   String?                 @map("attended_by_id")
  attendedAt     DateTime?               @map("attended_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  learner      LearnerProfile @relation(fields: [learnerId], references: [id])
  registeredBy AppUser?       @relation("InscribioAEvento", fields: [registeredById], references: [id])
  attendedBy   AppUser?       @relation("MarcoAsistenciaEvento", fields: [attendedById], references: [id])

  @@unique([eventId, learnerId])
  @@index([learnerId])
  @@map("event_registration")
}

enum IntegrationStatus {
  PENDIENTE
  ENVIADO
  ERROR
}

/// Cola de eventos de dominio hacia GoHighLevel / WhatsApp.
model IntegrationEvent {
  id        String            @id @default(uuid())
  event     String
  payload   Json
  status    IntegrationStatus @default(PENDIENTE)
  attempts  Int               @default(0)
  lastError String?           @map("last_error")
  sentAt    DateTime?         @map("sent_at")
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("integration_event")
}
